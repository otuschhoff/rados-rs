{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otuschhoff/go-librados/testdata/manifest.schema.json",
  "title": "go-librados protocol fixture provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture", "sha256", "kind", "source", "generator", "secrets", "license"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"enum": ["upstream-derived", "upstream-ceph-frameassembler", "native-oracle", "synthetic", "capture"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "paths"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "minProperties": 1},
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "locator", "revision", "role"],
            "properties": {
              "type": {"enum": ["ceph-source", "rfc", "openssl-runtime", "local-oracle", "production-dependency"]},
              "locator": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "command", "image"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "command": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "image": {"type": "string", "pattern": "^quay\\.io/ceph/ceph@sha256:[0-9a-f]{64}$"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_secrets", "synthetic_only"],
      "properties": {
        "contains_secrets": {"type": "boolean"},
        "synthetic_only": {"type": "boolean"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_expression", "redistribution", "reviewed_by"],
      "properties": {
        "upstream_expression": {"type": "string", "minLength": 1},
        "redistribution": {"enum": ["approved", "restricted", "pending"]},
        "reviewed_by": {"type": "string", "minLength": 1}
      }
    }
  }
}