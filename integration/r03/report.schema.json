{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otuschhoff/rados-rs/integration/r03/report.schema.json",
  "title": "rados-rs R03 messenger transcript bridge report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "status", "generated_at", "bounds", "fixtures", "rust", "go", "artifacts", "controller"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"const": "r03/messenger-transcript-v1"},
    "status": {"const": "passed"},
    "generated_at": {"type": "string", "format": "date-time"},
    "bounds": {"$ref": "#/$defs/bounds"},
    "fixtures": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/fixture"}},
    "rust": {"$ref": "#/$defs/implementation"},
    "go": {"$ref": "#/$defs/implementation"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "controller": {"$ref": "#/$defs/controller"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["max_record_bytes", "max_records", "max_input_bytes", "max_output_bytes"], "properties": {"max_record_bytes": {"const": 16384}, "max_records": {"const": 6}, "max_input_bytes": {"const": 4096}, "max_output_bytes": {"const": 8192}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["case_id", "path", "sha256", "manifest_path", "manifest_sha256"], "properties": {"case_id": {"enum": ["banner", "crc-frame", "secure-frame", "control-ack", "message-frame", "session-transition"]}, "path": {"type": ["string", "null"]}, "sha256": {"$ref": "#/$defs/sha256"}, "manifest_path": {"type": ["string", "null"]}, "manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["schema_version", "suite_id", "implementation_id", "case_id", "input_sha256", "output_sha256", "semantic", "status"], "properties": {"schema_version": {"const": 1}, "suite_id": {"const": "r03/messenger-transcript-v1"}, "implementation_id": {"enum": ["rust", "go"]}, "case_id": {"enum": ["banner", "crc-frame", "secure-frame", "control-ack", "message-frame", "session-transition"]}, "input_sha256": {"$ref": "#/$defs/sha256"}, "output_sha256": {"$ref": "#/$defs/sha256"}, "semantic": {"type": "object", "maxProperties": 16}, "status": {"const": "passed"}}},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["implementation_id", "source_revision", "source_tree", "source_files_sha256", "lockfile_sha256", "compiler", "target", "driver_sha256", "command", "exit_code", "stdout_sha256", "records"], "properties": {"implementation_id": {"enum": ["rust", "go"]}, "source_revision": {"type": "string", "minLength": 1, "maxLength": 64}, "source_tree": {"type": "string", "minLength": 1, "maxLength": 64}, "source_files_sha256": {"$ref": "#/$defs/sha256"}, "lockfile_sha256": {"$ref": "#/$defs/sha256"}, "compiler": {"type": "string", "minLength": 1, "maxLength": 256}, "target": {"type": "string", "minLength": 1, "maxLength": 128}, "driver_sha256": {"$ref": "#/$defs/sha256"}, "command": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "exit_code": {"const": 0}, "stdout_sha256": {"$ref": "#/$defs/sha256"}, "records": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/record"}}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["adapter_path", "adapter_sha256", "schema_path", "schema_sha256"], "properties": {"adapter_path": {"const": "tools/r03/go-probe"}, "adapter_sha256": {"$ref": "#/$defs/sha256"}, "schema_path": {"const": "integration/r03/report.schema.json"}, "schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "controller": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "command"], "properties": {"path": {"const": "integration/r03/reproduce.sh"}, "sha256": {"$ref": "#/$defs/sha256"}, "command": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}}
  }
}