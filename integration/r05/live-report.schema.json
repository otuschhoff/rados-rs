{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "command", "started_at", "finished_at", "source", "server", "toolchain", "cluster", "bounds", "scenarios", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "command": {"const": "integration/r05/live-reproduce.sh"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "artifacts"],
      "properties": {
        "identity": {"const": "exact-content-addressed-artifacts"},
        "artifacts": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}}
      }
    },
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "image_id", "ceph_version", "platform"],
      "properties": {
        "image": {"const": "quay.io/ceph/ceph@sha256:6e6bc7b28fa1b334108a3646af5533dfb50db508efdf5b358eb7dd0dd37a48aa"},
        "image_id": {"$ref": "#/$defs/dockerId"},
        "ceph_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "platform": {"enum": ["linux/amd64", "linux/arm64"]}
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["rustc", "cargo", "build_image", "build_image_id", "probe_binary_path", "probe_binary_sha256"],
      "properties": {
        "rustc": {"type": "string", "pattern": "^rustc 1\\.98\\.0 "},
        "cargo": {"type": "string", "pattern": "^cargo 1\\.98\\.0 "},
        "build_image": {"const": "rust@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922"},
        "build_image_id": {"const": "sha256:85d3116eeb31c371bc51214ee0d7f4c5655d5b6f903d448fff4d1ed8af272fd2"},
        "probe_binary_path": {"const": "target/r05/rados-r05-live"},
        "probe_binary_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cluster": {
      "type": "object", "additionalProperties": false,
      "required": ["fsid", "monitors", "seeds_used", "initial_pool", "disposable_pool", "failover_pool", "quorum_before", "quorum_after_loss"],
      "properties": {
        "fsid": {"const": "51111111-2222-4333-8444-555555555555"},
        "monitors": {"const": ["v2:172.30.105.10:3300", "v2:172.30.105.11:3300", "v2:172.30.105.12:3300"]},
        "seeds_used": {"const": ["v2:172.30.105.10:3300", "v2:172.30.105.11:3300", "v2:172.30.105.12:3300"]},
        "initial_pool": {"const": "r05-initial"},
        "disposable_pool": {"const": "r05-disposable"},
        "failover_pool": {"const": "r05-failover"},
        "quorum_before": {"const": 3},
        "quorum_after_loss": {"const": 2}
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["harness_seconds", "probe_seconds", "command_seconds", "max_output_bytes", "max_report_bytes"],
      "properties": {
        "harness_seconds": {"const": 600}, "probe_seconds": {"const": 120}, "command_seconds": {"const": 20},
        "max_output_bytes": {"const": 65536}, "max_report_bytes": {"const": 262144}
      }
    },
    "scenarios": {
      "type": "object", "additionalProperties": false,
      "required": ["secure_default_v2", "expected_pools", "pool_map_updates", "monitor_failover", "wrong_fsid", "bounded_cleanup"],
      "properties": {
        "secure_default_v2": {"const": "passed"}, "expected_pools": {"const": "passed"},
        "pool_map_updates": {"const": "passed"}, "monitor_failover": {"const": "passed"},
        "wrong_fsid": {"const": "passed"}, "bounded_cleanup": {"const": "passed"}
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["probe", "wrong_fsid", "cleanup"],
      "properties": {
        "probe": {"$ref": "#/$defs/probe"},
        "wrong_fsid": {"type": "object", "additionalProperties": false, "required": ["exit_code", "stderr_sha256", "fsid_mismatch_observed"], "properties": {"exit_code": {"type": "integer", "minimum": 1}, "stderr_sha256": {"$ref": "#/$defs/sha256"}, "fsid_mismatch_observed": {"const": true}}},
        "cleanup": {"type": "object", "additionalProperties": false, "required": ["orphan_containers", "orphan_networks"], "properties": {"orphan_containers": {"const": 0}, "orphan_networks": {"const": 0}}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dockerId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "poolNames": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 4096},
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "fsid", "instance_id", "configured_security", "authenticated", "initial_pools", "created_pools", "deleted_pools", "failover_pools"],
      "properties": {
        "schema_version": {"const": 1}, "fsid": {"const": "51111111-2222-4333-8444-555555555555"},
        "instance_id": {"type": "integer", "minimum": 1}, "configured_security": {"const": "secure"}, "authenticated": {"const": true},
        "initial_pools": {"$ref": "#/$defs/poolNames"}, "created_pools": {"$ref": "#/$defs/poolNames"},
        "deleted_pools": {"$ref": "#/$defs/poolNames"}, "failover_pools": {"$ref": "#/$defs/poolNames"}
      }
    }
  }
}