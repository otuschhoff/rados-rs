{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otuschhoff/rados-rs/integration/r06/report.schema.json",
  "title": "rados-rs R06 deterministic placement differential report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "status", "generated_at", "bounds", "fixtures", "rust", "go", "artifacts", "controller"],
  "properties": {
    "schema_version": {"const": 1},
    "suite_id": {"const": "r06/placement-v1"},
    "status": {"const": "passed"},
    "generated_at": {"type": "string", "format": "date-time"},
    "bounds": {"$ref": "#/$defs/bounds"},
    "fixtures": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/fixture"}},
    "rust": {"$ref": "#/$defs/implementation"},
    "go": {"$ref": "#/$defs/implementation"},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "controller": {"$ref": "#/$defs/controller"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "caseId": {"enum": ["p05-direct-baseline", "p05-direct-osd1-out", "p05-object-baseline", "p05-object-pg32", "p05-object-osd1-out", "p05-object-upmap", "p10-erasure-baseline", "p10-erasure-osd1-out", "p10-erasure-object-baseline", "p10-erasure-object-osd1-out", "p10-erasure-object-primary-affinity"]},
    "fixturePath": {"enum": ["testdata/r06/p05/crushmap.bin", "testdata/r06/p05/mappings.txt", "testdata/r06/p05/mappings-osd1-out.txt", "testdata/r06/p05/object-mappings.txt", "testdata/r06/p05/object-mappings-pg32.txt", "testdata/r06/p05/object-mappings-osd1-out.txt", "testdata/r06/p05/object-mappings-upmap.txt", "testdata/r06/p05/upmap-commands.txt", "testdata/r06/p10/crushmap.bin", "testdata/r06/p10/mappings.txt", "testdata/r06/p10/mappings-osd1-out.txt", "testdata/r06/p10/object-placements.jsonl", "testdata/r06/p10/object-placements-osd1-out.jsonl", "testdata/r06/p10/object-placements-primary-affinity.jsonl"]},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["max_record_bytes", "max_records", "max_input_bytes", "max_output_bytes", "max_seconds"], "properties": {"max_record_bytes": {"const": 16384}, "max_records": {"const": 11}, "max_input_bytes": {"const": 1048576}, "max_output_bytes": {"const": 4096}, "max_seconds": {"const": 30}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "manifest_path", "manifest_sha256"], "properties": {"path": {"$ref": "#/$defs/fixturePath"}, "sha256": {"$ref": "#/$defs/sha256"}, "manifest_path": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "semantic": {"type": "object", "additionalProperties": false, "required": ["kind", "row_count", "normalized_sha256", "native_normalized_sha256"], "properties": {"kind": {"enum": ["direct", "object"]}, "row_count": {"enum": [128, 256]}, "normalized_sha256": {"$ref": "#/$defs/sha256"}, "native_normalized_sha256": {"$ref": "#/$defs/sha256"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["schema_version", "suite_id", "implementation_id", "case_id", "input_sha256", "output_sha256", "semantic", "status"], "properties": {"schema_version": {"const": 1}, "suite_id": {"const": "r06/placement-v1"}, "implementation_id": {"enum": ["rust", "go"]}, "case_id": {"$ref": "#/$defs/caseId"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "output_sha256": {"$ref": "#/$defs/sha256"}, "semantic": {"$ref": "#/$defs/semantic"}, "status": {"const": "passed"}}},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["implementation_id", "source_revision", "source_tree", "source_before_sha256", "source_after_sha256", "lockfile_sha256", "compiler", "target", "binary_path", "binary_sha256", "command", "exit_code", "stdout_sha256", "records"], "properties": {"implementation_id": {"enum": ["rust", "go"]}, "source_revision": {"type": "string", "minLength": 1, "maxLength": 64}, "source_tree": {"type": "string", "minLength": 1, "maxLength": 64}, "source_before_sha256": {"$ref": "#/$defs/sha256"}, "source_after_sha256": {"$ref": "#/$defs/sha256"}, "lockfile_sha256": {"$ref": "#/$defs/sha256"}, "compiler": {"type": "string", "minLength": 1, "maxLength": 256}, "target": {"type": "string", "minLength": 1, "maxLength": 128}, "binary_path": {"type": "string", "minLength": 1, "maxLength": 4096}, "binary_sha256": {"$ref": "#/$defs/sha256"}, "command": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "exit_code": {"const": 0}, "stdout_sha256": {"$ref": "#/$defs/sha256"}, "records": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/record"}}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["adapter_path", "adapter_sha256", "schema_path", "schema_sha256"], "properties": {"adapter_path": {"const": "tools/r06/go-probe"}, "adapter_sha256": {"$ref": "#/$defs/sha256"}, "schema_path": {"const": "integration/r06/report.schema.json"}, "schema_sha256": {"$ref": "#/$defs/sha256"}}},
    "controller": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "command"], "properties": {"path": {"const": "integration/r06/reproduce.sh"}, "sha256": {"$ref": "#/$defs/sha256"}, "command": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}}
  }
}